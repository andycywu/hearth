  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": { "@hearthkit/platform-api": "workspace:*" },
  "devDependencies": { "@types/node": "^22.0.0" },
  "license": "Apache-2.0"
}
