{
  "name": "@hearthkit/skill-manifest",
  "version": "0.1.0",
  "description": "Skills as data: interpret a JSON manifest as an agent tool. No code is loaded, so the app's CSP and 'no remote code' property are preserved. See docs/adr/0002.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./examples/*": "./examples/*"
  },
  "files": ["dist", "examples"],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@hearthkit/core": "workspace:*",
    "@hearthkit/platform-api": "workspace:*"
  },
  "license": "Apache-2.0"
}
