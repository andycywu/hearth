# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo
apps/tizen-app/*.wgt
apps/aosp-app/**/build/
apps/aosp-app/.gradle/
apps/aosp-app/local.properties

# Env & secrets
.env
.env.*
# …except the template, which holds placeholders and no values.
!.env.example
*.keystore
*.p12
signing/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log

# pnpm temp probe artifacts
_tmp_*

# Generated SBOM / release artifacts
sbom.json
dist-release/

# Generated runtime bundles (produced by tools/bundle.mjs)
apps/tizen-app/main.js
apps/tizen-app/main.js.map
apps/aosp-app/app/src/main/assets/main.js
apps/aosp-app/app/src/main/assets/main.js.map
apps/webos-app/main.js
apps/webos-app/main.js.map
apps/webos-app/*.ipk
apps/webos-app/dist-ipk/
apps/dev-harness/main.js
apps/dev-harness/main.js.map

# Generated by tools/package-tizen.mjs at package time (holds baked launch flags).
launch-flags.js

# Signing artifacts left in the source tree by `tizen package`
apps/tizen-app/author-signature.xml
apps/tizen-app/signature1.xml
apps/tizen-app/.manifest.tmp
apps/tizen-app/*.wgt

# tizen-core (`tz build`) build output. This was committed once — a signed .wgt,
# two signature files carrying X509 certificates, a 126 KB SDK temp file and a
# stale bundle, ~800 KB of it. Build output does not belong in a repository, and
# signing material belongs there least of all.
apps/tizen-app/Debug/
apps/tizen-app/Release/
apps/tizen-app/.buildResult/
