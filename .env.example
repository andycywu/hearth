# Copy to `.env.local`, fill in, and source it before running:
#
#   cp .env.example .env.local && $EDITOR .env.local
#   set -a; . ./.env.local; set +a          # bash/zsh
#
# `.env` and `.env.*` are gitignored — this template is the only one tracked, and
# it must never hold a real value. `pnpm secrets:check` runs in CI and will fail
# the build if a credential reaches a tracked file.

# --- ModelPilot (the decision engine) --------------------------------------
# Environment or host global only. Never a launch URL: a television's launch URL
# lives in shell history, in the launch intent and in logcat, and on a shipped
# model the key is identical on every unit.
MODELPILOT_API_KEY=your-key-here
MODELPILOT_MODE=shadow
# MODELPILOT_BASE_URL=https://modelpilot.andycywu.workers.dev
# MODELPILOT_BASE_URL=http://127.0.0.1:8090      # tools/mock-modelpilot-server.mjs
# MODELPILOT_TIMEOUT_MS=5000
# MODELPILOT_MAX_COST=0.05

# --- The model the agent talks to directly ---------------------------------
# TV_AGENT_LLM=http://127.0.0.1:11434/v1
# TV_AGENT_MODEL=llama3.2
# TV_AGENT_API_KEY=your-key-here

# On a television there is no environment to set. Provision instead:
#   Android TV   adb shell am start -n tv.aiagent.harness/.MainActivity -e mpKey <key>
#   dev harness  window.__MODELPILOT_API_KEY__ = "…"   before the bundle loads
