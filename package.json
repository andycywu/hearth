{
  "name": "hearthkit",
  "version": "0.1.0",
  "private": true,
  "description": "Hearth — an AI agent runtime for smart TVs and living-room devices. Cross-OS, verified, and it never claims to have done something it didn't.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/tizen-app",
    "apps/aosp-app",
    "apps/webos-app",
    "apps/dev-harness"
  ],
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build && pnpm --filter @hearthkit/cli run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "eslint .",
    "dev:web": "pnpm --filter @hearthkit/adapter-web run dev",
    "bundle:tizen": "pnpm build && node tools/bundle.mjs tizen",
    "bundle:aosp": "pnpm build && node tools/bundle.mjs aosp",
    "bundle:all": "pnpm build && node tools/bundle.mjs tizen && node tools/bundle.mjs aosp",
    "bundle:webos": "pnpm build && node tools/bundle.mjs webos",
    "bundle:dev": "pnpm build && node tools/bundle.mjs dev",
    "dev": "pnpm bundle:dev && node tools/serve.mjs apps/dev-harness",
    "doctor": "node tools/doctor.mjs",
    "new:skill": "node packages/create-skill/index.mjs",
    "package:tizen": "pnpm build && node tools/package-tizen.mjs",
    "package:webos": "pnpm build && node tools/package-webos.mjs",
    "icon": "node tools/make-icon.mjs",
    "bench": "pnpm build && node tools/bench.mjs",
    "check:size": "node tools/check-bundle-size.mjs",
    "license:check": "node tools/license-check.mjs",
    "sbom": "node tools/sbom.mjs"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "eslint": "^9.9.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "esbuild": "^0.23.0"
  }
}
