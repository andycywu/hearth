# The Node floor is a gate, not an advertisement.
#
# Without this, pnpm's `engine-strict` defaults to false: `engines.node` in
# package.json is read, found not to match, and ignored without a word. Installing
# on a runtime the project does not support then succeeds, which is the same shape
# of wrong answer this runtime exists to refuse — a confident yes from something
# that cannot actually do it.
#
# With it, `pnpm install` on anything below the floor fails and names the version
# it wanted. `.nvmrc` carries that number for anyone with fnm, nvm or Volta, and
# `engines.node` carries it for everyone else.
engine-strict=true
