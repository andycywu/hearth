<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://aiagent.tv/harness"
        version="0.2.0" viewmodes="maximized">
  <!--
    package MUST be exactly 10 alphanumeric characters. "tvaiagent" (9) is
    silently rejected by the installer as
      install failed[118, -4] ... Operation not allowed : :Load archive info fail
    which says nothing about the id. Hence the trailing 0.
  -->
  <tizen:application id="tvaiagent0.TvAiAgent"
                     package="tvaiagent0"
                     required_version="6.0"/>
  <content src="index.html"/>
  <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>
  <icon src="icon.png"/>
  <name>Hearth</name>
  <tizen:profile name="tv"/>

  <!-- Privileges required by the HAL adapter. Trim to what your firmware allows. -->
  <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
  <tizen:privilege name="http://tizen.org/privilege/application.info"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.audio"/>
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>

  <!--
    Required for the app to reach *any* network host. The `internet` privilege
    above is necessary but not sufficient: the Widget Access Request Policy
    denies every external origin unless one is declared here, and a widget with
    no access element at all reaches nothing.

    Without it the model call fails as a bare "TypeError: Failed to fetch",
    which reads exactly like a CSP block or a dead server, and is neither. The
    Tizen emulator's own shell could curl the endpoint fine while the app
    could not.

    `*` because the endpoint is chosen at runtime (`?llm=`), so there is no host
    to name at package time. The narrower gate stays the `connect-src` CSP in
    index.html; tighten this to your own endpoint for a retail build.
  -->
  <access origin="*" subdomains="true"/>

  <tizen:setting screen-orientation="landscape"
                 context-menu="disable"
                 background-support="disable"
                 encryption="disable"
                 hwkey-event="enable"/>
</widget>
